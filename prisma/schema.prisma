generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Settings {
  id              String   @id @default("singleton")
  pin             String
  aiProvider      String   @default("OPENAI")
  openaiApiKey    String?
  openaiModel     String   @default("gpt-4o-mini")
  ollamaBaseUrl   String   @default("http://localhost:11434")
  ollamaModel     String   @default("llama3.2")
  geminiApiKey       String?
  geminiModel        String   @default("gemini-2.5-flash")
  telegramBotToken   String?
  telegramChatId     String?
  telegramEnabled    Boolean  @default(false)
  timezone           String   @default("UTC")
  weatherApiKey   String?
  weatherCity     String   @default("Mumbai")
  temperatureUnit String   @default("C")
  theme           String   @default("dark")
  dashboardLayout String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Task {
  id              String    @id @default(cuid())
  title           String
  description     String?
  priority        String    @default("MEDIUM")
  status          String    @default("TODO")
  category        String?
  dueDate         DateTime?
  completedAt     DateTime?
  recurringTaskId String?
  reminderAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([recurringTaskId])
}

model RecurringTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    String    @default("MEDIUM")
  status      String    @default("ACTIVE")
  frequency   String
  interval    Int       @default(1)
  daysOfWeek  String?
  dayOfMonth  Int?
  cronExpr    String?
  nextDueAt   DateTime
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([nextDueAt])
  @@index([status])
}

model RecurringExpense {
  id          String    @id @default(cuid())
  description String
  amount      Float
  category    String
  frequency   String
  interval    Int       @default(1)
  dayOfMonth  Int?
  nextDueAt   DateTime
  lastPaidAt  DateTime?
  autoApprove Boolean   @default(false)
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([nextDueAt])
  @@index([status])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  color       String   @default("#3b82f6")
  allDay      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startTime, endTime])
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Float
  type        String
  category    String
  description String?
  date        DateTime
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([date])
  @@index([category])
}

model Budget {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  month     Int
  year      Int
  createdAt DateTime @default(now())

  @@unique([category, month, year])
}

model Habit {
  id        String     @id @default(cuid())
  name      String
  icon      String     @default("✅")
  color     String     @default("#10b981")
  frequency String     @default("DAILY")
  createdAt DateTime   @default(now())
  logs      HabitLog[]
}

model HabitLog {
  id        String  @id @default(cuid())
  habitId   String
  date      String
  completed Boolean @default(true)
  habit     Habit   @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
  @@index([date])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pinned])
}

model QuickLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  icon      String?
  category  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

model JournalEntry {
  id        String   @id @default(cuid())
  date      String   @unique
  content   String   @default("")
  mood      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model FocusSession {
  id          String   @id @default(cuid())
  taskId      String?
  duration    Int
  type        String   @default("WORK")
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([completedAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model ChatConversation {
  id        String        @id @default(cuid())
  title     String
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           String
  content        String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}
