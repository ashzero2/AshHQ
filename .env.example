# AshHQ Configuration

# Database (SQLite — auto-set in Docker)
DATABASE_URL="file:./prisma/ashhq.db"

# Session secret — CHANGE THIS to a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# AI providers (optional — configure in Settings UI instead)
OPENAI_API_KEY=
GEMINI_API_KEY=

# OpenWeatherMap (optional — configure in Settings UI instead)
WEATHER_API_KEY=

# Ollama URL (if using local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# Telegram bot (optional — can also be set in Settings UI)
# Get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set TELEGRAM_ENABLED=false to disable even if token/chat ID are set
TELEGRAM_ENABLED=true

# Scheduler secret — protect POST /api/scheduler (optional)
SCHEDULER_SECRET=
